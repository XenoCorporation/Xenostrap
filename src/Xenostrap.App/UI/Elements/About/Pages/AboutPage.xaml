<ui:UiPage x:Class="Xenostrap.UI.Elements.About.Pages.AboutPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Xenostrap.UI.Elements.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dmodels="clr-namespace:Xenostrap.UI.ViewModels.About" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:models="clr-namespace:Xenostrap.UI.ViewModels" xmlns:resources="clr-namespace:Xenostrap.Resources" xmlns:util="clr-namespace:Xenostrap.Utility" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="AboutPage" Scrollable="True" xmlns:pages="clr-namespace:Xenostrap.UI.Elements.About.Pages" KeyDown="UiPage_KeyDown">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Storyboard x:Key="EggStoryboard">
        <DoubleAnimation Storyboard.TargetName="Image1" Storyboard.TargetProperty="Opacity" From="1.0" To="0.0" Duration="0:0:3" />
        <DoubleAnimation Storyboard.TargetName="Image2" Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:3" />
      </Storyboard>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel Margin="0,0,14,14">
    <Grid Margin="0,0,0,24" HorizontalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image Name="Image1" Grid.Column="0" Width="72" Height="72" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Source="pack://application:,,,/Xenostrap.png" />
      <Image Name="Image2" Grid.Column="0" Width="72" Height="72" VerticalAlignment="Center" Opacity="0" RenderOptions.BitmapScalingMode="HighQuality" Source="pack://application:,,,/Resources/BootstrapperStyles/ByfronDialog/Matt.png" />
      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Margin="0,0,4,0" FontSize="24" FontWeight="Medium" Text="Xenostrap" />
        </Grid>
        <TextBlock Text="A Simple yet Advanced, Bloxstrap Fork." />
      </StackPanel>
    </Grid>
    <WrapPanel HorizontalAlignment="Center" Orientation="Horizontal" ItemHeight="40" ItemWidth="Auto">
            <ui:Anchor Margin="0,0,8,0" Content="{x:Static resources:Strings.Menu_About_ReportIssue}" Icon="BookExclamationMark24" NavigateUri="https://github.com/XenoCorporation/Xenostrap/issues" />
            <ui:Anchor Margin="0,0,8,0" Content="Website" Icon="Globe20" NavigateUri="https://xenostrapp.pages.dev" />
      <ui:Anchor Content="{x:Static resources:Strings.Menu_About_DiscordServer}" Icon="Chat48" NavigateUri="https://discord.gg/Ay7GhEvxYZ" Click="Anchor_Click" />
    </WrapPanel>
    <TextBlock Margin="0,16,0,0" FontFamily="Segoe UI Semibold" FontSize="20" FontWeight="Medium" Text="Main Contributors" />
    <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="These are the people who have made the main contributions to Xenostrap, helping make it real." TextWrapping="Wrap" />
    <StackPanel Orientation="Vertical" Margin="0,8,0,0">
      <ui:Card Padding="12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Image Width="48" Height="48" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" util:DynamicRenderSystem.LazyImageSource="https://avatars.githubusercontent.com/u/195697851?v=4" />
          <StackPanel Grid.Column="1" Margin="12,0,0,0">
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="nguyenlegiabao13" />
            <TextBlock Opacity="0.7" Text="Love Everyone With a Purpose." />
          </StackPanel>
        </Grid>
      </ui:Card>
    </StackPanel>
    <TextBlock Margin="0,16,0,0" FontFamily="Segoe UI Semibold" FontSize="20" FontWeight="Medium" Text="{x:Static resources:Strings.Menu_About_Contributors}" />
    <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="These are the people who have made notable contributions to Xenostrap, helping make it what it is." TextWrapping="Wrap" />
    <Grid Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <controls:Expander Grid.Column="0" Margin="0,0,4,0" BorderThickness="2,2,2,2" HeaderIcon="Code24" HeaderText="Coders" IsExpanded="False">
        <StackPanel>
          <controls:MarkdownTextBlock MarkdownText="[nguyenlegiabao13](https://github.com/nguyenlegiabao13)" />
        </StackPanel>
      </controls:Expander>
      <controls:Expander Grid.Column="1" Margin="4,0,4,0" BorderThickness="2,2,2,2" HeaderIcon="AppsAddIn28" HeaderText="Contribution" IsExpanded="False">
        <StackPanel>
          <controls:MarkdownTextBlock MarkdownText="[nguyenlegiabao13(https://github.com/nguyenlegiabao13)" />
        </StackPanel>
      </controls:Expander>
      <controls:Expander Grid.Column="2" Margin="4,0,0,0" BorderThickness="2,2,2,2" HeaderIcon="Heart20" HeaderText="Inspirations" IsExpanded="False">
        <StackPanel>
          <controls:MarkdownTextBlock MarkdownText="[Bloxstrap](https://github.com/MaximumADHD)" />
        </StackPanel>
      </controls:Expander>
    </Grid>
    <StackPanel Visibility="{Binding BuildInformationVisibility, Mode=OneTime}">
      <TextBlock Margin="0,16,0,0" FontFamily="Segoe UI Semibold" FontSize="20" Text="Build Information" />
      <Grid Margin="0,4,0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" FontSize="14" FontWeight="Medium" Text="Updated:" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBlock Grid.Row="0" Grid.Column="1" FontSize="14" VerticalAlignment="Center" Text="{Binding BuildTimestamp, Mode=OneTime}" />
        <TextBlock Grid.Row="1" Grid.Column="0" FontSize="14" FontWeight="Medium" Text="Version:" VerticalAlignment="Center" Margin="0,4,8,0" />
        <TextBlock Grid.Row="1" Grid.Column="1" FontSize="14" VerticalAlignment="Center" Text="{Binding Version, Mode=OneTime}" />
        <TextBlock Grid.Row="2" Grid.Column="0" FontSize="14" FontWeight="Medium" Text="Commit Hash:" VerticalAlignment="Center" Margin="0,4,8,0" Visibility="{Binding BuildCommitVisibility, Mode=OneTime}" />
        <TextBlock Grid.Row="2" Grid.Column="1" FontSize="14" VerticalAlignment="Center" Text="{Binding CommitHash, Mode=OneTime}" Visibility="{Binding BuildCommitVisibility, Mode=OneTime}" />
        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" VerticalAlignment="Bottom" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding BuildCommitVisibility, Mode=OneTime}">
          <Hyperlink Command="models:GlobalViewModel.OpenWebpageCommand" Foreground="{DynamicResource TextFillColorTertiaryBrush}" CommandParameter="{Binding BuildCommitHashUrl, Mode=OneTime}">
            <TextBlock Text="{Binding BuildMetadata.CommitHash, Mode=OneTime}" />
          </Hyperlink>
        </TextBlock>
        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,4,16,4" FontSize="14" FontWeight="Medium" Text="Commit Ref" Visibility="{Binding BuildCommitVisibility, Mode=OneTime}" />
        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,4" VerticalAlignment="Bottom" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding BuildMetadata.CommitRef, Mode=OneTime}" Visibility="{Binding BuildCommitVisibility, Mode=OneTime}" />
      </Grid>
    </StackPanel>
    <TextBlock Margin="0,16,0,0" FontFamily="Segoe UI Semibold" FontSize="20" Text="Third Party Notices" />
    <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Text="This software contains source code provided by NVIDIA Corporation. Frame generation uses the NVIDIA Optical Flow SDK FRUC library on supported NVIDIA GPUs." />
  </StackPanel>
</ui:UiPage>
